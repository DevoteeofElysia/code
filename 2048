#include<stdio.h>
#include<stdlib.h>
#include<time.h>
#define FAN 4  //设定边长(目前只能是正方形)
typedef struct
{
	int num;
	int yn;
}MO;
void output(int arr[FAN][FAN]);
void random(int arr[FAN][FAN]);
int moveplug(MO brr[]);
int move(int arr[FAN][FAN], char a);
int judge(int arr[FAN][FAN]);

int main()
{
	int arr[FAN][FAN] = { 0 };
	srand(time(NULL));
	random(arr);
	random(arr);
	while (1)
	{
		output(arr);
		if (judge(arr) == 1)
			break;
		printf("请下达指令，master:");
		char a;
		scanf(" %c", &a);
		if (move(arr, a))
			continue;
		random(arr);
	}
	return 0;
}

int judge(int arr[FAN][FAN])
{
	int sum=0;
	for(int i=0;i<FAN;i++)
		for (int j = 0;j < FAN;j++)
		{
			if (arr[i][j] == 2048)
			{
				printf("游戏胜利！！！\n");
				return 1;
			}
			if (arr[i][j] == 0)
				sum++;
		}
	if (sum == 0)//一个零也没有，全被填完了
	{
		int qb = 0;
		for (int i = 0;i < FAN;i++)
			for (int j = 0;j < FAN-1;j++)
				if (arr[i][j] == arr[i][j + 1] || arr[j][i] == arr[j + 1][i])
					qb = 1;
		if (qb == 0)
		{
			printf("game over");
			return 1;
		}
	}
	return 0;
}
int moveplug(MO brr[])
{
	int change = 0;
	for (int j = 0;j < FAN-1;j++)
		for (int q = 0;q + j < FAN-1;q++)
		{
			if (brr[j + q].num == 0)
			{
				MO temp = brr[j + q];
				brr[j + q] = brr[j + q + 1];
				brr[j + q + 1] = temp;
				change = 1;
			}
			else if (brr[j + q].num == brr[j + q + 1].num && brr[j + q].yn != 1)
			{
				brr[j + q].num += brr[j + q + 1].num;
				brr[j + q + 1].num = 0;
				brr[j + q].yn = 1;
				change = 1;
			}
		}
	if (change == 0)
		return 0;
	else
		return 1;
}
int move(int arr[FAN][FAN], char a)
{
	int change = 0;
	if (a == 'a')//向左滑动
	{
		for (int i = 0;i < FAN;i++)//定位某一行
		{
			MO brr[FAN] = { 0 };
			int k = 0;
			for (int j = 0;j < FAN;j++)
				if (arr[i][j] != 0)
				{
					brr[k].num = arr[i][j];
					k++;
				}
			if (moveplug(brr))
				change = 1;
			for (int j = 0;j < FAN;j++)
				arr[i][j] = brr[j].num;
		}
	}
	else if (a == 'd')
	{
		for (int i = 0;i < FAN;i++)//定位某一行
		{
			MO brr[FAN] = { 0 };
			int k = 0;
			for (int j = 0;j < FAN;j++)
				if (arr[i][FAN-1-j] != 0)
				{
					brr[k].num = arr[i][FAN-1-j];
					k++;
				}
			if (moveplug(brr))
				change = 1;
			for (int j = 0;j < FAN;j++)
				arr[i][j] = brr[FAN-1-j].num;
		}
	}
	else if (a == 'w')
	{
		for (int i = 0;i < FAN;i++)//定位某一列
		{
			MO brr[FAN] = { 0 };
			int k = 0;
			for (int j = 0;j < FAN;j++)
				if (arr[j][i] != 0)
				{
					brr[k].num = arr[j][i];
					k++;
				}
			if (moveplug(brr))
				change = 1;
			for (int j = 0;j < FAN;j++)
				arr[j][i] = brr[j].num;
		}
	}
	else if (a == 's')
	{
		for (int i = 0;i < FAN;i++)//定位某一列
		{
			MO brr[FAN] = { 0 };
			int k = 0;
			for (int j = 0;j < FAN;j++)
				if (arr[FAN-1-j][i] != 0)
				{
					brr[k].num = arr[FAN-1-j][i];
					k++;
				}
			if (moveplug(brr))
				change = 1;
			for (int j = 0;j < FAN;j++)
				arr[j][i] = brr[FAN-1-j].num;
		}
	}
	else
	{
		printf("输入错误，请重新输入\n");
		return 1;
	}
	if (change == 0)
	{
		printf("移动无效\n");
		return 1;
	}
	return 0;
}
void random(int arr[FAN][FAN])
{
	int count = 0;// 先检查是否已满
	for (int i = 0; i < FAN; i++)
		for (int j = 0; j < FAN; j++)
			if (arr[i][j] == 0) count++;
	if (count == 0) return;
	while (1)
	{
		int a = rand() % FAN;
		int b = rand() % FAN;
		int sum = rand() % 10;
		if (arr[a][b] == 0)
		{
			if (sum == 0)
				arr[a][b] = 4;
			else
				arr[a][b] = 2;
			return;
		}
	}
}
void output(int arr[FAN][FAN])
{
	for (int i = 0; i < FAN; i++) 
	{
		printf("\n");
		for (int j = 0; j < FAN; j++) 
		{
			if (arr[i][j] == 0)
				printf("     "); // 统一4个字符宽度
			else
				printf("%4d ", arr[i][j]); // 使用 %4d 保证右对齐，宽度一致
		}
		printf("\n");
	}
}
